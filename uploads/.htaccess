# Prevent directory listing
Options -Indexes

# Block execution of scripts (Modern Apache 2.4 syntax)
<FilesMatch "\.(php|php5|phtml|pl|py|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
